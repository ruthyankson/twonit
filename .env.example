# Copy this file to .env.local and fill in the values from the same
# Supabase project `application`/`twonit-admin` use (Project Settings ->
# API in the Supabase dashboard). Both are meant to be public -- see
# README.md's "Pilot form backend" section for why that's safe here.
#
# Without these set, the pilot form falls back to its old
# not-actually-saved behavior rather than crashing the site.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
